@charset "utf-8";

* { margin: 0px; padding: 0px; outline: none; }

body { background: rgba(38, 38, 38, 0.5); backdrop-filter: blur(5px); height: 100%; }

#ad_iframe { display: block; left: auto; margin: 0px auto; position: relative; top: auto; }

.creative { transition: opacity 1s; position: relative; }

#creative { border-radius: 0px; padding: 0px; position: relative; box-shadow: none; z-index: 0; }

html { height: 100%; }

.attribution { position: relative; padding: 0px; margin: 12px 4px 0px; float: left; }

#ad_position_box { display: flex; align-items: flex-start; justify-content: center; height: 100%; width: 100%; }

#top-glasspane { position: absolute; top: 0px; width: 100%; height: 8vh; }

#bottom-glasspane { position: absolute; bottom: 0px; width: 100%; height: 8vh; }

#left-glasspane { position: absolute; left: 0px; width: 8vw; height: 100%; }

#right-glasspane { position: absolute; right: 0px; width: 8vw; height: 100%; }

.close-button-protector, .skip-button-protector { width: auto; position: absolute; top: 0px; right: 0px; left: auto; height: auto; z-index: 10000; }

.controller-hidden { display: none; }

.continue-prompt-text, .skip-prompt-text { display: flex; padding-top: 4.5px; font-family: Roboto, sans-serif; font-size: 12px; user-select: none; white-space: nowrap; padding-left: 8px; padding-right: 8px; color: rgb(0, 0, 0); }

.skip-prompt-text { padding-left: 8px; padding-right: 0px; }

.close-button-outer, .skip-button-outer { margin: 2px 2px 14px 14px; padding: 10px; }

.close-button, .skip-button { width: auto; display: flex; flex-direction: row; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 100px; filter: drop-shadow(rgba(0, 0, 0, 0.19) 0px 1px 3px); opacity: 0.8; z-index: 10001; position: relative; cursor: pointer; margin: 0px; height: 24px; background: rgb(255, 255, 255); }

.close-button circle { display: none; }

#count-down-text { display: none; }

.progress-bar { z-index: 10001; position: absolute; top: 0px; left: 0px; margin: 0px; width: 100vw; box-sizing: border-box; height: 4px; background: rgb(239, 240, 252); display: flex; flex-direction: row; justify-content: flex-start; align-items: center; box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 4px 0px; border-radius: 14px; opacity: 1; }

.progress-bar.loaded { display: none; }

.progress-bar .progress-bar-inner { height: 4px; width: 0%; background-color: rgb(247, 206, 70); border-radius: 14px; }
