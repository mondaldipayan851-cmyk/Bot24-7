@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; position: relative; }

html, body { width: 100%; height: 100%; }

html { font-size: 15px; }

body { font-family: Roboto, sans-serif; background: transparent; color: rgb(33, 33, 33); user-select: none; cursor: default; display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; text-align: left; padding: 4px; }

.wrapper { width: 100%; max-width: 260px; height: 100%; max-height: 368px; border-radius: 15px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.2) 0px 0px 3px; }

.pic { width: 100%; height: 160px; background-image: url("//arachescrag.cyou/lp/i/23/8f/238fcbe9b87f7fc8c1731dcf1b96aea49f5fa347.jpg"); background-position: center center; background-size: cover; border-radius: 14px 14px 0px 0px; cursor: pointer; }

.info { width: 100%; height: calc(100% - 160px); padding: 12px 16px 20px; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; -webkit-box-pack: justify; justify-content: space-between; }

.info_bottom { width: 100%; }

.title { display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: start; justify-content: flex-start; width: 100%; }

.title img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; margin-right: 10px; cursor: pointer; }

.title p { text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

.title p:hover { cursor: pointer; text-decoration: underline; }

h1 { font-weight: 700; font-size: 1.2rem; line-height: 1.5rem; margin: 10px 0px 15px; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; max-height: 64px; overflow: hidden; text-overflow: ellipsis; }

.text { color: rgb(96, 96, 96); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; max-height: 36px; overflow: hidden; text-overflow: ellipsis; line-height: 1.5rem; }

.actions { display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: justify; justify-content: space-between; }

.icon { height: 25px; opacity: 0.8; }

.icon:hover { cursor: pointer; opacity: 1; }

button { padding: 8px 20px; font-size: 1rem; font-weight: 600; color: rgb(255, 255, 255); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: rgb(15, 55, 198); border-radius: 3px; }

button:hover { cursor: pointer; transform: scale(1.02); }

.close { width: 17px; position: absolute; top: 8px; right: 8px; opacity: 0.5; }

.close:hover { cursor: pointer; opacity: 0.8; }
