.btn-default { color: rgb(255, 255, 255); background-image: linear-gradient(to right, rgba(21, 5, 80, 0.92) 0%, rgb(63, 12, 108) 51%, rgba(21, 5, 80, 0.92) 100%); }

h1, h2, h3, h4, h5, h6 { color: rgb(90, 90, 90); }

.stat { font-family: Montserrat, sans-serif; color: rgb(255, 255, 255); }

section.stats { background: -webkit-linear-gradient(left top, rgba(21, 5, 80, 0.92), rgba(63, 12, 108, 0.92)), url("https://shrinkme.io/bkabstract.svg"); }

footer { background: -webkit-linear-gradient(left top, rgba(21, 5, 80, 0.92), rgb(63, 12, 108)), url(""); }

footer .social-links ul li a { color: rgb(21, 5, 80); }

footer .copyright-container { font-family: Montserrat, sans-serif; border-top: 1px solid rgba(255, 255, 255, 0.1); }

.step-num span { font-family: Montserrat, sans-serif; color: rgb(255, 255, 255); padding: 11px; line-height: 19px; font-size: 19px; width: 40px; height: 40px; display: inline-block; background-image: linear-gradient(90deg, rgb(63, 12, 108) 7%, rgba(21, 5, 80, 0.92) 100%) !important; border-radius: 0px 15px !important; }

.btn-contact { color: rgb(255, 255, 255); border-color: rgb(255, 255, 255) !important; background-image: linear-gradient(90deg, rgb(63, 12, 108) 7%, rgba(21, 5, 80, 0.92) 100%) !important; border-radius: 0px 15px !important; }

.section-subheading { color: rgb(5, 0, 56) !important; text-transform: uppercase !important; font-style: normal !important; }

.navbar-default .navbar-toggle .icon-bar { background-color: rgb(5, 0, 54); }

.step { padding: 54px 44px; border-radius: 5px; border-width: 2px; border-style: solid; border-color: currentcolor; border-image: linear-gradient(45deg, rgb(255, 192, 140), rgb(170, 39, 140) 30%, rgb(14, 202, 212)) 1 / 1 / 0 stretch; box-sizing: border-box; box-shadow: rgba(67, 65, 78, 0.08) 0px 6px 12px 0px; }

header .intro-text .intro-lead-in { font-weight: 500; text-transform: uppercase; font-family: sans-serif; font-style: normal; }

header .intro-text .intro-heading { color: rgb(250, 192, 37); font-family: Montserrat, sans-serif; }

section h2.section-heading::after { border-bottom: 5px solid rgb(250, 192, 37); }

.ms-sprite { background-image: url("https://shrinkme.io/spritesheet8.webp"); }

img#cleverImageCreative { display: none !important; }

img#cleverLogoClick { display: none !important; }

@media screen and (max-width: 800px) {
  .desktoponly-code { display: none; visibility: hidden; }
}
